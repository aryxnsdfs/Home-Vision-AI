# Frontend → backend API base URL.
#
# Local dev: leave UNSET. The app auto-targets the local FastAPI:
#   http://127.0.0.1:8000/api
#
# Production: set this to your deployed backend's /api path.
#   - Same domain behind a reverse proxy:   VITE_API_URL=/api
#   - Separate backend host:                VITE_API_URL=https://api.your-domain.com/api
#
# Vite inlines this at BUILD time, so rebuild after changing it.
VITE_API_URL=
